# Lasso 配置模板
# 复制为 .env 后按实际环境填写；本文件只允许出现占位值，禁止提交真实地址、密钥或账号。
# 生成密钥示例（每个环境各生成一次，不要复用）：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# ─── 基础 ───
DEBUG=false
# 生产必须替换为随机长字符串（>= 50 字符）
SECRET_KEY=<generate-a-random-secret-key>
# 允许访问的域名/IP，逗号分隔；本地开发可用 localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
# 是否允许自助注册；企业内部通常关闭，由管理员建号
ALLOW_REGISTER=false
# 前端跨域来源（开发时通常留空，由 Vite 代理）
CORS_ALLOWED_ORIGINS=
# 反代链路上受信任的代理地址，逗号分隔；直连部署可留空
AUTH_TRUSTED_PROXIES=
# 上传文件大小上限（字节）
UPLOAD_MAX_SIZE=26214400

# ─── 登录保护 ───
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=300

# ─── JWT ───
# 与 SECRET_KEY 分开，便于单独轮换；更换后所有已签发令牌失效
JWT_SIGNING_KEY=<generate-a-separate-jwt-signing-key>
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── 数据库 ───
# sqlite3（默认，仅本地开发）或 postgresql
DB_ENGINE=sqlite3
DB_NAME=lasso
DB_USER=lasso
DB_PASSWORD=<set-a-strong-database-password>
DB_HOST=127.0.0.1
DB_PORT=5432

# ─── MCP 凭据静态加密 ───
# 用于加密存储的 MCP Secret；导出包永不包含该密钥
MCP_SECRET_KEY=<generate-a-random-mcp-secret-key>
# 可选：额外允许的解释器路径（默认已允许当前进程解释器与 python/python3）
MCP_PYTHON_BIN=

# ─── 技能包镜像目录 ───
SKILLS_MIRROR_DIR=./data/skills

# ─── 检索 / 向量库 ───
# none（不启用向量检索）或 qdrant
VECTOR_STORE=none
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=lasso
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5
FASTEMBED_CACHE_DIR=./data/models

# ─── 异步任务 ───
# 没有 Redis 时保持 eager=true，任务在请求内同步执行
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_TIME_LIMIT=600

# ─── 知识库 OCR（扫描 PDF / 图片入库）──
# auto 三级回退：多模态模型 → 本机 tesseract → 该页记未解析
# 部署前置（tesseract + 中文语言包）见 deploy/ops/install_ocr.sh 与 docs/DEPLOYMENT.md
KNOWLEDGE_OCR_MIN_TEXT_CHARS=16
KNOWLEDGE_OCR_MAX_PAGES=200
KNOWLEDGE_OCR_RENDER_SCALE=2.0
KNOWLEDGE_OCR_LANG=chi_sim+eng
KNOWLEDGE_OCR_TIMEOUT=60
KNOWLEDGE_OCR_LLM_TIMEOUT=60
KNOWLEDGE_OCR_LLM_MAX_TOKENS=4096

# ─── 模型网关（兼容 OpenAI 协议）──
# 也可登录后在「平台设置」中配置并做连通性验证
LLM_BASE_URL=https://your-llm-gateway.example.com/v1
LLM_API_KEY=<your-llm-api-key>
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ─── SearXNG（天工 L2 默认搜索，平台托管代理配置）──
# 部署前置（settings.yml 的 ACL 与 sudoers）见 docs/SEARXNG.md
SEARXNG_SETTINGS_PATH=/etc/searxng/settings.yml
SEARXNG_SRC=/opt/searxng
SEARXNG_VENV_PYTHON=/opt/searxng/venv/bin/python
SEARXNG_HEALTH_URL=http://127.0.0.1:8888/healthz
SEARXNG_RESTART_CMD=sudo -n systemctl restart searxng
SEARXNG_BACKUP_DIR=/var/backups/lasso-searxng
